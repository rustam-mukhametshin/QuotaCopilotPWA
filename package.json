{
  "name": "quota-copilot-pwa",
  "version": "0.15.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201 --configuration development",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "check": "npm run test -- --watch=false && npm run format:check && npm run lint",
    "test": "ng test",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format": "prettier --write src/ && eslint src/ --fix",
    "screenshot": "node scripts/screenshot-dev.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "bootstrap": "5.3.8",
    "dexie": "4.4.7",
    "rxjs": "~7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/pwa": "22.2.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
